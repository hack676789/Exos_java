type Task {
    id: ID!
    title: String!
    description: String
}

type Query {
    getAllTasks: [Task]
    getTaskById(id: ID!): Task
}

type Mutation {
    createTask(title: String!, description: String): Task
    updateTask(id: ID!, title: String, description: String): Task
    deleteTask(id: ID!): Boolean
}
